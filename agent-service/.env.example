# Java Backend (System of Record) API
BACKEND_BASE_URL=http://localhost:8080

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_INTENT_MODEL=gpt-4o-mini

# LLM 调用预算（ARCH-2/2b）：实时档要人等（意图分类、面试逐轮），后台档可以慢（报告/提案/摘要）。
# 解析重试**共享**这一次操作的截止时间；剩余预算低于 LLM_MIN_ATTEMPT_MS 时不再发起新尝试。
LLM_TIMEOUT_REALTIME_SECONDS=20
LLM_TIMEOUT_BACKGROUND_SECONDS=120
LLM_PARSE_RETRIES=1
LLM_MIN_ATTEMPT_MS=1500
# 输入总长与结构化输出 token 上限（业务侧已按各自上限裁剪，这里是兜底）
LLM_MAX_INPUT_CHARS=16000
LLM_MAX_OUTPUT_TOKENS=1024

# LangGraph Checkpoint（PostgreSQL，独立库，需手动创建：CREATE DATABASE agent_checkpoint）
CHECKPOINT_DATABASE_URL=postgresql://postgres:123456@localhost:5432/agent_checkpoint

# 短期记忆（会话历史注入）
HISTORY_MAX_MESSAGES=8
HISTORY_MAX_MESSAGE_CHARS=500
SUMMARY_TRIGGER_MESSAGES=12

# 简历内容注入上限（Agent 内容级分析 / 简历优化）
RESUME_CONTEXT_MAX_CHARS=8000

# FastAPI
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8000
